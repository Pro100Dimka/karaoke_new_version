[Unit]
Description=A&D Voice processing queue
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/karaoke-processing-server
EnvironmentFile=/etc/ad-voice-processing.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/karaoke-room-server/.venv/bin/python -B /opt/karaoke-processing-server/processing-server.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/karaoke-processing-server/data
MemoryMax=512M
CPUQuota=50%
TasksMax=64

[Install]
WantedBy=multi-user.target
