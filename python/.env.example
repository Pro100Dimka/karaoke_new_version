AD_VOICE_DATA=./data
AD_VOICE_PORT=8765
AD_VOICE_LOG_LEVEL=INFO
# Optional Shazam-style recognition. AudD supplies identity/catalog metadata;
# YouTube Data API adds the matching embeddable music video.
# AD_VOICE_AUDD_TOKEN=your-audd-token
# AD_VOICE_YOUTUBE_API_KEY=your-google-api-key
# Optional external local AI adapter:
# AD_VOICE_AI_COMMAND=C:\\path\\to\\provider.exe
# AD_VOICE_AI_VERSION=1
