{
  "name": "ad-voice-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json && vite build",
    "typecheck": "tsc -b tsconfig.app.json --pretty false && tsc -p electron/tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:audio-network": "node electron/local-room-network-smoke.mjs",
    "test:audio-network-vocal-processes": "node electron/network-vocal-process-test.mjs",
    "test:audio-network-resilience": "node electron/network-resilience-process-test.mjs",
    "test:audio-network-soak": "node electron/network-soak-test.mjs --minutes=30",
    "e2e": "playwright test",
    "electron:compile": "tsc -p electron/tsconfig.json && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.js",
    "electron:install": "install-electron",
    "electron": "npm run electron:compile && electron .",
    "check:rules": "node scripts/check-rules.mjs",
    "check:security": "npm audit --audit-level=moderate",
    "dev:app": "node scripts/dev-electron.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "formik": "^2.4.9",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^42.11.8",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
