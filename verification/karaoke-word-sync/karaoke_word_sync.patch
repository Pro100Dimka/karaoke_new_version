+from __future__ import annotations
+
+from collections.abc import Sequence
+import json
+from pathlib import Path
+
+import numpy as np
+import pytest
+import torch
+
+from backend.ai_worker import ctc
+from backend.ai_worker.recognition import alignment_payload
+
