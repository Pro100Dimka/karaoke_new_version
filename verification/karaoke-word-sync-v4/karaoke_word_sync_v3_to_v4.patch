+        active = np.flatnonzero(voiced[first : anchor + 1])
+        entry = first + int(active[0])
+        if not voiced[entry : anchor + 1].all():
+            return None  # An intervening sound may be a real quiet opening, not padding.
+        return entry * voice_step
+    return None
 
 
